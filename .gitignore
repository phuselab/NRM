__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg

.env
.venv/
venv/
env/

# ── Fetched by fetch_assets.py, never committed ──────────────────────
# Large embeddings (GitHub Release of this repository). The SC embeddings
# (0.4 MB) and the NRM weights stay in git.
embeddings/**/*.pt
!embeddings/sc/sc_embeddings.pt

# Third-party data, downloaded from the original publishers or rebuilt locally.
datasets/rdm/teddm_data.csv
datasets/rdm/videos/
datasets/sat/*.txt
datasets/sat/data/
datasets/sat/ILSVRC
datasets/sat/imagenet_mapping.csv
datasets/sc/experiment_1.csv
datasets/sc/stimuli/
datasets/sc/sun_filtered/
.cache/

# Competitor weights are not distributed: retrain with competitors/*/train_*.py
# (the ConvRNN ImageNet backbone is fetched from its authors).
competitors/weights/**
!competitors/weights/
!competitors/weights/*/
!competitors/weights/**/README.md

# SCAN code has no upstream licence: fetched from SATBench, not redistributed.
competitors/scan/*
!competitors/scan/train_sat.py
!competitors/scan/README.md

# RTify's cached backbone states for RDM (~33 GB). Only needed to recompute
# RTify's RDM row from the model; see competitors/weights/rdm/README.md.
competitors/weights/rdm/rtify_backbone_states*.pth

# ── Retrained weights and refreshed outputs ──────────────────────────────────
# Retraining and REFRESH runs write next to the released files with a _REFRESH
# suffix; they are local results, not part of the release.
nrm/weights/*_REFRESH.*
competitors/weights/**/*_REFRESH.*
outputs/**/*_REFRESH*
outputs/**/*_REFRESH/

checkpoints/

*.log
.DS_Store
Thumbs.db

wandb/
.ipynb_checkpoints/

# Per-model SAT plots and tensors: regenerated by `competitors/*/train_sat.py`,
# read by nothing. Only sat_level_curves.json and satbench_metrics_full.json
# feed pipelines/sat.ipynb.
outputs/**/*.png
outputs/**/*.pt
outputs/**/sat_level_metrics_table.tex
outputs/**/sat_level_metrics_table.csv
